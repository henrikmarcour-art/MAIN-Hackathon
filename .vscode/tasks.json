{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "MaasNow: Start dev (npm run up)",
      "type": "shell",
      "command": "npm run up",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": {
        "owner": "next",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting",
          "endsPattern": "Ready in"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "isBackground": true,
      "runOptions": { "instanceLimit": 1 }
    }
  ]
}
